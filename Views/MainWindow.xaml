<Window x:Class="AudioQualityEnhancer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AudioQualityEnhancer.Services"
        xmlns:models="clr-namespace:AudioQualityEnhancer.Models"
        mc:Ignorable="d"
        Title="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}"
        Width="1200"
        Height="840"
        MinWidth="980"
        MinHeight="700"
        Background="#F4F6F5"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragEnter="MainWindow_OnDragEnter"
        Drop="MainWindow_OnDrop"
        Loaded="MainWindow_OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8DFDA" />
        <SolidColorBrush x:Key="TextBrush" Color="#18211B" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6D66" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B5D56" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8E6" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#E4B653" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#BBC8C1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF4F1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#BBC8C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="InsightSeverityBadgeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#365149" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Warning}">
                    <Setter Property="Foreground" Value="#8A4B00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Critical}">
                    <Setter Property="Foreground" Value="#9A1B1B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding [MainWindow_Subtitle], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ToolStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding [Field_Language], Source={x:Static loc:LocalizationService.Instance}}"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name"
                              Width="110" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Right"
                           MaxWidth="430"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Section_Source], Source={x:Static loc:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Border BorderBrush="#AFC2BA"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Background="#F9FBFA"
                                    Padding="18"
                                    Margin="0,0,0,12"
                                    AllowDrop="True"
                                    DragEnter="MainWindow_OnDragEnter"
                                    Drop="MainWindow_OnDrop">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Hint_DropFiles], Source={x:Static loc:LocalizationService.Instance}}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding [Hint_DropFilesOrSelect], Source={x:Static loc:LocalizationService.Instance}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_SelectFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding SelectFileCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_RemoveSelectedFile], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding RemoveSelectedFileCommand}" />
                                <Button Grid.Column="4"
                                        Content="{Binding [Button_ClearFinishedFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding ClearFinishedFilesCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding BatchSummaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,8" />

                            <DataGrid ItemsSource="{Binding BatchItems}"
                                      SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      MinHeight="150"
                                      MaxHeight="220"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [Field_File], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="{Binding [Field_Status], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding StatusDisplay}" Width="105" />
                                    <DataGridTextColumn Header="{Binding [Field_ScoreShort], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ScoreDisplay}" Width="72" />
                                    <DataGridTextColumn Header="{Binding [Field_Progress], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ProgressDisplay}" Width="78" />
                                    <DataGridTextColumn Header="{Binding [Field_Message], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ErrorMessage}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{Binding [Field_SelectedFile], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasMultipleAudioStreams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Field_AudioTrack], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableAudioStreams}"
                                          SelectedItem="{Binding SelectedAudioStream, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Text="{Binding [Hint_AudioTrack], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_PlaySource], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding PlaySourceCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_PlayOutput], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding PlayOutputCommand}" />
                                <Button Grid.Column="4"
                                        Content="{Binding [Button_StopPreview], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding StopPreviewCommand}" />
                            </Grid>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}">
                                <Slider Minimum="0"
                                        Maximum="{Binding PreviewDurationSeconds}"
                                        Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                        IsEnabled="{Binding IsPreviewActive}" />
                                <TextBlock Text="{Binding PreviewTimeText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Section_Analysis], Source={x:Static loc:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Field_Codec], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioInfo.CodecDisplay, TargetNullValue='-'}" TextWrapping="Wrap" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [Field_Container], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding AudioInfo.ContainerDisplay, TargetNullValue='-'}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Field_BitRate], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioInfo.BitRateDisplay, TargetNullValue='-'}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [Field_SampleRate], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AudioInfo.SampleRateDisplay, TargetNullValue='-'}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Field_Channels], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AudioInfo.ChannelsDisplay, TargetNullValue='-'}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [Field_Duration], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AudioInfo.DurationDisplay, TargetNullValue='-'}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Field_FileSize], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AudioInfo.FileSizeDisplay, TargetNullValue='-'}" Margin="0,0,18,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding [Field_Source], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding AudioInfo.LossyDisplay, TargetNullValue='-'}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Field_Loudness], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,10,8" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AudioDiagnostics.IntegratedLoudnessDisplay, TargetNullValue='-'}" Margin="0,12,18,8" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding [Field_TruePeak], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,10,8" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding AudioDiagnostics.TruePeakDisplay, TargetNullValue='-'}" Margin="0,12,0,8" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [Field_MaxPeak], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AudioDiagnostics.MaxVolumeDisplay, TargetNullValue='-'}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding [Field_MeanVolume], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding AudioDiagnostics.MeanVolumeDisplay, TargetNullValue='-'}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Field_LoudnessRange], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AudioDiagnostics.LoudnessRangeDisplay, TargetNullValue='-'}" Margin="0,0,18,0" />
                            </Grid>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVis}}">
                                <Separator Margin="0,0,0,12" />
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Width="92">
                                        <TextBlock Text="{Binding [Field_AnalysisScore], Source={x:Static loc:LocalizationService.Instance}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding AnalysisReport.ScoreDisplay}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AnalysisReport.StatusText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AnalysisReport.Summary}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding [Section_AnalysisFindings], Source={x:Static loc:LocalizationService.Instance}}"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding AnalysisReport.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding SeverityDisplay}"
                                                           Style="{StaticResource InsightSeverityBadgeStyle}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding AnalysisReport.HasRecommendations, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [Section_AnalysisRecommendations], Source={x:Static loc:LocalizationService.Instance}}"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,6" />
                                    <ItemsControl ItemsSource="{Binding AnalysisReport.Recommendations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Left"
                                        Content="{Binding [Button_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding AnalyzeDiagnosticsCommand}" />
                                <TextBlock Text="{Binding [Hint_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding AnalysisWarningText}"
                                       Visibility="{Binding HasAnalysisWarnings, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Foreground="#8A4B00"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}"
                            Background="{StaticResource WarningBackgroundBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Section_QualityLimits], Source={x:Static loc:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding QualityNotice}" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Section_Processing], Source={x:Static loc:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding [Field_Preset], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0"
                                          Content="{Binding [Checkbox_TwoPassLoudness], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding UseTwoPassLoudness}"
                                          IsEnabled="{Binding IsLoudnessPreset}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="1"
                                          Content="{Binding [Checkbox_SpeechCompression], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding EnableSpeechCompression}"
                                          IsEnabled="{Binding IsSpeechPreset}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="2"
                                          Content="{Binding [Checkbox_SpeechPresenceBoost], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding EnableSpeechPresenceBoost}"
                                          IsEnabled="{Binding IsSpeechPreset}"
                                          Margin="0,0,0,8" />
                                <StackPanel Grid.Row="3">
                                    <DockPanel>
                                        <TextBlock Text="{Binding [Field_NoiseFilter], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding NoiseReductionFloor, StringFormat={}{0} dB}"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DockPanel>
                                    <Slider Minimum="-35"
                                            Maximum="-20"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding NoiseReductionFloor}"
                                            IsEnabled="{Binding IsNoisePreset}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding [Field_ExportFormat], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ExportFormats}"
                                      SelectedItem="{Binding SelectedExportFormat}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedExportFormat.Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding [Field_FilterDetails], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FilterDetailsText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="76"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Section_Output], Source={x:Static loc:LocalizationService.Instance}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding [Field_OutputFolder], Source={x:Static loc:LocalizationService.Instance}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_SelectFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding SelectOutputFolderCommand}" />
                            </Grid>

                            <CheckBox Content="{Binding [Checkbox_SaveLog], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding SaveLogFile}"
                                      Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_OpenOutputFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding OpenOutputFolderCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_OpenLastOutput], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding OpenLastOutputCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding [Field_CurrentFileProgress], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,4" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         Height="14"
                                         Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding ProcessingPhaseText}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </DockPanel>

                            <TextBlock Text="{Binding [Field_OverallProgress], Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,4" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding OverallProgressValue, Mode=OneWay}"
                                         Height="14"
                                         Margin="0,0,0,8" />
                            <TextBlock Text="{Binding OverallProgressValue, StringFormat={}{0:0}%}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_StartQueue], Source={x:Static loc:LocalizationService.Instance}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_Cancel], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding CancelCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}" Margin="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding [Section_Log], Source={x:Static loc:LocalizationService.Instance}}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="{Binding [Button_CopyLog], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding CopyLogCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="{Binding [Button_ClearLog], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding ClearLogCommand}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MinHeight="210"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding [Footer_Disclaimer], Source={x:Static loc:LocalizationService.Instance}}"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
