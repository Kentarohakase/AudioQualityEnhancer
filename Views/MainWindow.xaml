<Window x:Class="AudioQualityEnhancer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AudioQualityEnhancer.Services"
        xmlns:models="clr-namespace:AudioQualityEnhancer.Models"
        mc:Ignorable="d"
        Title="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}"
        Width="1260"
        Height="880"
        MinWidth="1020"
        MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragEnter="MainWindow_OnDragEnter"
        Drop="MainWindow_OnDrop"
        Loaded="MainWindow_OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="SectionIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="WarningCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="10" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="RowHeight" Value="28" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="InsightSeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InfoBadgeBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningBadgeBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Critical}">
                    <Setter Property="Background" Value="{DynamicResource CriticalBadgeBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InsightSeverityBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBadgeForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AudioInsightSeverity.Critical}">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,14"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [MainWindow_Subtitle], Source={x:Static loc:LocalizationService.Instance}}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToolStatusText}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />

                    <TextBlock Text="&#xE771;"
                               Style="{StaticResource SectionIconStyle}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="14"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="Name"
                              Width="100"
                              Margin="0,0,16,0" />

                    <TextBlock Text="&#xE774;"
                               Style="{StaticResource SectionIconStyle}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="14"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name"
                              Width="110" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main two-column dashboard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Source / Queue -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{Binding [Section_Source], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource DropZoneBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Background="{DynamicResource DropZoneBackgroundBrush}"
                                    Padding="18"
                                    Margin="0,0,0,12"
                                    AllowDrop="True"
                                    DragEnter="MainWindow_OnDragEnter"
                                    Drop="MainWindow_OnDrop">
                                <StackPanel>
                                    <TextBlock Text="&#xE8E5;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding [Hint_DropFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding [Hint_DropFilesOrSelect], Source={x:Static loc:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_SelectFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding SelectFileCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_RemoveSelectedFile], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding RemoveSelectedFileCommand}" />
                                <Button Grid.Column="4"
                                        Content="{Binding [Button_ClearFinishedFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding ClearFinishedFilesCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding BatchSummaryText}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,8" />

                            <DataGrid ItemsSource="{Binding BatchItems}"
                                      SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      MinHeight="160"
                                      MaxHeight="230"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [Field_File], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="{Binding [Field_Status], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding StatusDisplay}" Width="105" />
                                    <DataGridTextColumn Header="{Binding [Field_ScoreShort], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ScoreDisplay}" Width="72" />
                                    <DataGridTextColumn Header="{Binding [Field_ResultCheckShort], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ValidationStatusDisplay}" Width="92" />
                                    <DataGridTextColumn Header="{Binding [Field_Progress], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ProgressDisplay}" Width="78" />
                                    <DataGridTextColumn Header="{Binding [Field_Message], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding ErrorMessage}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{Binding [Field_SelectedFile], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasMultipleAudioStreams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Field_AudioTrack], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableAudioStreams}"
                                          SelectedItem="{Binding SelectedAudioStream, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Text="{Binding [Hint_AudioTrack], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_PlaySource], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding PlaySourceCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_PlayOutput], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding PlayOutputCommand}" />
                                <Button Grid.Column="4"
                                        Content="{Binding [Button_StopPreview], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding StopPreviewCommand}" />
                            </Grid>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}">
                                <Slider Minimum="0"
                                        Maximum="{Binding PreviewDurationSeconds}"
                                        Value="{Binding PreviewPositionSeconds, Mode=TwoWay}"
                                        IsEnabled="{Binding IsPreviewActive}" />
                                <TextBlock Text="{Binding PreviewTimeText}"
                                           Style="{StaticResource LabelStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Analysis -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{Binding [Section_Analysis], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Field_Codec], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioInfo.CodecDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [Field_Container], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding AudioInfo.ContainerDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Field_BitRate], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioInfo.BitRateDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [Field_SampleRate], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AudioInfo.SampleRateDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Field_Channels], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AudioInfo.ChannelsDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [Field_Duration], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AudioInfo.DurationDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Field_FileSize], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AudioInfo.FileSizeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding [Field_Source], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding AudioInfo.LossyDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Field_Loudness], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,14,10,8" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AudioDiagnostics.IntegratedLoudnessDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,14,18,8" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding [Field_TruePeak], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,14,10,8" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding AudioDiagnostics.TruePeakDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,14,0,8" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [Field_MaxPeak], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AudioDiagnostics.MaxVolumeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding [Field_MeanVolume], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding AudioDiagnostics.MeanVolumeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Field_LoudnessRange], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AudioDiagnostics.LoudnessRangeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,0" />
                            </Grid>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVis}}">
                                <Separator />
                                <DockPanel Margin="0,4,0,0">
                                    <Border DockPanel.Dock="Left"
                                            Width="86"
                                            Height="86"
                                            CornerRadius="10"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            Margin="0,0,16,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AnalysisReport.ScoreDisplay}"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding [Field_AnalysisScore], Source={x:Static loc:LocalizationService.Instance}}"
                                                       Style="{StaticResource LabelStyle}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AnalysisReport.StatusText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AnalysisReport.Summary}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding [Section_AnalysisFindings], Source={x:Static loc:LocalizationService.Instance}}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding AnalysisReport.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource InsightSeverityBadgeStyle}">
                                                    <TextBlock Text="{Binding SeverityDisplay}" Style="{StaticResource InsightSeverityBadgeTextStyle}" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding AnalysisReport.HasRecommendations, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [Section_AnalysisRecommendations], Source={x:Static loc:LocalizationService.Instance}}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,6,0,6" />
                                    <ItemsControl ItemsSource="{Binding AnalysisReport.Recommendations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Left"
                                        Content="{Binding [Button_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding AnalyzeDiagnosticsCommand}" />
                                <TextBlock Text="{Binding [Hint_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding AnalysisWarningText}"
                                       Visibility="{Binding HasAnalysisWarnings, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Quality Limits -->
                    <Border Style="{StaticResource WarningCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE7BA;"
                                           Style="{StaticResource SectionIconStyle}"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                                <TextBlock Text="{Binding [Section_QualityLimits], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding QualityNotice}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Processing -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE713;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{Binding [Section_Processing], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>

                            <TextBlock Text="{Binding [Field_Preset], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedPreset.Description}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,14" />

                            <StackPanel Margin="0,0,0,12">
                                <CheckBox Content="{Binding [Checkbox_TwoPassLoudness], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding UseTwoPassLoudness}"
                                          IsEnabled="{Binding IsLoudnessPreset}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="{Binding [Checkbox_SpeechCompression], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding EnableSpeechCompression}"
                                          IsEnabled="{Binding IsSpeechPreset}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="{Binding [Checkbox_SpeechPresenceBoost], Source={x:Static loc:LocalizationService.Instance}}"
                                          IsChecked="{Binding EnableSpeechPresenceBoost}"
                                          IsEnabled="{Binding IsSpeechPreset}"
                                          Margin="0,0,0,8" />
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding [Field_NoiseFilter], Source={x:Static loc:LocalizationService.Instance}}"
                                                   Style="{StaticResource LabelStyle}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding NoiseReductionFloor, StringFormat={}{0} dB}"
                                                   Style="{StaticResource LabelStyle}" />
                                    </DockPanel>
                                    <Slider Minimum="-35"
                                            Maximum="-20"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding NoiseReductionFloor}"
                                            IsEnabled="{Binding IsNoisePreset}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding [Field_ExportFormat], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ExportFormats}"
                                      SelectedItem="{Binding SelectedExportFormat}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedExportFormat.Description}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="{Binding [Field_FilterDetails], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding FilterDetailsText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="72"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Output & Progress -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{Binding [Section_Output], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>

                            <TextBlock Text="{Binding [Field_OutputFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_SelectFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding SelectOutputFolderCommand}" />
                            </Grid>

                            <CheckBox Content="{Binding [Checkbox_SaveLog], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding SaveLogFile}"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="{Binding [Checkbox_SaveReport], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding SaveReportFile}"
                                      Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_OpenOutputFolder], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding OpenOutputFolderCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_OpenLastOutput], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding OpenLastOutputCommand}" />
                                <Button Grid.Column="4"
                                        Content="{Binding [Button_OpenLastReport], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding OpenLastReportCommand}" />
                            </Grid>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding [Field_CurrentFileProgress], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                           Style="{StaticResource LabelStyle}" />
                            </DockPanel>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ProcessingPhaseText}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding [Field_OverallProgress], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding OverallProgressValue, StringFormat={}{0:0}%}"
                                           Style="{StaticResource LabelStyle}" />
                            </DockPanel>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding OverallProgressValue, Mode=OneWay}"
                                         Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding [Button_StartQueue], Source={x:Static loc:LocalizationService.Instance}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartCommand}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Button_Cancel], Source={x:Static loc:LocalizationService.Instance}}"
                                        Command="{Binding CancelCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Result Validation -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding HasComparisonReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{Binding [Section_ResultValidation], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding ComparisonReport.StatusText}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ComparisonReport.Summary}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding ComparisonReport.OutputPathDisplay}"
                                           Style="{StaticResource LabelStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding [Section_ResultFindings], Source={x:Static loc:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ComparisonReport.Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource InsightSeverityBadgeStyle}">
                                                <TextBlock Text="{Binding SeverityDisplay}" Style="{StaticResource InsightSeverityBadgeTextStyle}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [Section_ResultMetrics], Source={x:Static loc:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,4,0,6" />
                            <DataGrid ItemsSource="{Binding ComparisonReport.Metrics}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      MinHeight="160"
                                      MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [Field_Metric], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="{Binding [Field_Source], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding SourceValue}" Width="*" />
                                    <DataGridTextColumn Header="{Binding [Field_Output], Source={x:Static loc:LocalizationService.Instance}}" Binding="{Binding OutputValue}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Log -->
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="&#xE9D5;" Style="{StaticResource SectionIconStyle}" />
                                    <TextBlock Text="{Binding [Section_Log], Source={x:Static loc:LocalizationService.Instance}}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="{Binding [Button_CopyLog], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding CopyLogCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="{Binding [Button_ClearLog], Source={x:Static loc:LocalizationService.Instance}}"
                                            Command="{Binding ClearLogCommand}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MinHeight="200"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <DockPanel Grid.Row="2" Margin="2,8,2,0">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       TextAlignment="Right"
                       MaxWidth="600"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding [Footer_Disclaimer], Source={x:Static loc:LocalizationService.Instance}}"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
