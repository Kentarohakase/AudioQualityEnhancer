<Window x:Class="AudioQualityEnhancer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AudioQualityEnhancer.Services"
        xmlns:sections="clr-namespace:AudioQualityEnhancer.Views.Sections"
        mc:Ignorable="d"
        Title="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}"
        Width="1260"
        Height="880"
        MinWidth="1020"
        MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragEnter="MainWindow_OnDragEnter"
        Drop="MainWindow_OnDrop"
        Loaded="MainWindow_OnLoaded">
    <Grid Margin="22,18,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <sections:AppBarSection Grid.Row="0" />

        <!-- Main two-column dashboard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <sections:SourceSection />
                    <sections:AnalysisSection />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <sections:ProcessingSection />
                    <sections:OutputSection />
                    <sections:ResultValidationSection />
                    <sections:LogSection />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <DockPanel Grid.Row="2" Margin="2,8,2,0">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       TextAlignment="Right"
                       MaxWidth="600"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding [Footer_Disclaimer], Source={x:Static loc:LocalizationService.Instance}}"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
