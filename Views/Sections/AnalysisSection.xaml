<UserControl x:Class="AudioQualityEnhancer.Views.Sections.AnalysisSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AudioQualityEnhancer.Services">
    <StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource SectionIconStyle}" />
                    <TextBlock Text="{Binding [Section_Analysis], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Field_Codec], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudioInfo.CodecDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" Margin="0,0,18,8" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [Field_Container], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding AudioInfo.ContainerDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Field_BitRate], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioInfo.BitRateDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [Field_SampleRate], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AudioInfo.SampleRateDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Field_Channels], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AudioInfo.ChannelsDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [Field_Duration], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AudioInfo.DurationDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Field_FileSize], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AudioInfo.FileSizeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding [Field_Source], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding AudioInfo.LossyDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Field_Loudness], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,14,10,8" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AudioDiagnostics.IntegratedLoudnessDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,14,18,8" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding [Field_TruePeak], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,14,10,8" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding AudioDiagnostics.TruePeakDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,14,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [Field_MaxPeak], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AudioDiagnostics.MaxVolumeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,8" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding [Field_MeanVolume], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,8" />
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding AudioDiagnostics.MeanVolumeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Field_LoudnessRange], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AudioDiagnostics.LoudnessRangeDisplay, TargetNullValue='-'}" Style="{StaticResource ValueStyle}" Margin="0,0,18,0" />
                </Grid>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVis}}">
                    <Separator />
                    <DockPanel Margin="0,4,0,0">
                        <Border DockPanel.Dock="Left"
                                Width="86"
                                Height="86"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                Margin="0,0,16,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AnalysisReport.ScoreDisplay}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding [Field_AnalysisScore], Source={x:Static loc:LocalizationService.Instance}}"
                                           Style="{StaticResource LabelStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AnalysisReport.StatusText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding AnalysisReport.Summary}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding [Section_AnalysisFindings], Source={x:Static loc:LocalizationService.Instance}}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding AnalysisReport.Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource InsightSeverityBadgeStyle}">
                                        <TextBlock Text="{Binding SeverityDisplay}" Style="{StaticResource InsightSeverityBadgeTextStyle}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding AnalysisReport.HasRecommendations, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding [Section_AnalysisRecommendations], Source={x:Static loc:LocalizationService.Instance}}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,6,0,6" />
                        <ItemsControl ItemsSource="{Binding AnalysisReport.Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Left"
                            Content="{Binding [Button_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding AnalyzeDiagnosticsCommand}" />
                    <TextBlock Text="{Binding [Hint_AdvancedAnalysis], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource LabelStyle}"
                               TextWrapping="Wrap"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding AnalysisWarningText}"
                           Visibility="{Binding HasAnalysisWarnings, Converter={StaticResource BoolToVis}}"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           FontSize="12"
                           Foreground="{DynamicResource WarningTextBrush}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource WarningCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE7BA;"
                               Style="{StaticResource SectionIconStyle}"
                               Foreground="{DynamicResource WarningTextBrush}" />
                    <TextBlock Text="{Binding [Section_QualityLimits], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding QualityNotice}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
