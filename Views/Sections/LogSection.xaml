<UserControl x:Class="AudioQualityEnhancer.Views.Sections.LogSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AudioQualityEnhancer.Services">
    <Border Style="{StaticResource CardStyle}" Margin="0">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource SectionIconStyle}" />
                    <TextBlock Text="{Binding [Section_Log], Source={x:Static loc:LocalizationService.Instance}}"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding [Button_CopyLog], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding CopyLogCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding [Button_ClearLog], Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </DockPanel>
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     MinHeight="200"
                     VerticalContentAlignment="Top" />
        </StackPanel>
    </Border>
</UserControl>
