<UserControl x:Class="AudioQualityEnhancer.Views.Sections.AppBarSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AudioQualityEnhancer.Services">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20,14"
            Margin="0,0,0,14">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationService.Instance}}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding [MainWindow_Subtitle], Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="{Binding UpdateNoticeText}"
                        Command="{Binding OpenUpdateCommand}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,16,0" />
                <TextBlock Text="{Binding ToolStatusText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />

                <TextBlock Text="&#xE771;"
                           Style="{StaticResource SectionIconStyle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Name"
                          Width="100"
                          Margin="0,0,16,0" />

                <TextBlock Text="&#xE774;"
                           Style="{StaticResource SectionIconStyle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Name"
                          Width="110" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
